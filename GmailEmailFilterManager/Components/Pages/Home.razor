@page "/"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@inject GmailEmailFilterManager.Services.EmailService EmailService

<PageTitle>Gmail Email Filter Manager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudText Typo="Typo.h5" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" />
        Gmail Email Filter Manager
    </MudText>

    @* ── Eingabe-Karte ── *@
    <MudCard Class="mb-4" Elevation="2">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" />
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.subtitle1"><b>E-Mail hinzufügen</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Duplikate werden abgelehnt · Dauerhaft gespeichert</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid AlignItems="AlignItems.End">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_inputEmail"
                                  Label="E-Mail-Adresse"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                  AdornmentColor="Color.Primary"
                                  Placeholder="name@beispiel.de"
                                  InputType="InputType.Email"
                                  Immediate="true"
                                  Error="@(_errorMessage != null)"
                                  ErrorText="@_errorMessage"
                                  OnKeyDown="@OnKeyDown" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               FullWidth="true"
                               OnClick="AddEmail"
                               Class="mb-1">
                        Hinzufügen
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_successMessage != null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2"
                          ShowCloseIcon="true" CloseIconClicked="() => _successMessage = null">
                    @_successMessage
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>

    @* ── Tabellen-Karte ── *@
    <MudCard Class="mb-4" Elevation="2">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" />
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.subtitle1">
                    <b>Gespeicherte Adressen</b>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">
                        @EmailService.Emails.Count
                    </MudChip>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Alle einzigartigen E-Mail-Adressen</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-0">
            @if (EmailService.Emails.Count == 0)
            {
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" Color="Color.Tertiary" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        Noch keine E-Mails – füge oben die erste hinzu.
                    </MudText>
                </MudStack>
            }
            else
            {
                <MudTable Items="@EmailService.Emails" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Xs" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="width:50px">#</MudTh>
                        <MudTh>E-Mail-Adresse</MudTh>
                        <MudTh Style="width:70px; text-align:right">Aktion</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @(EmailService.Emails.ToList().IndexOf(context) + 1)
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@context</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Title="Entfernen"
                                           OnClick="@(() => RemoveEmail(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCardContent>
        @if (EmailService.Emails.Count > 0)
        {
            <MudCardActions>
                <MudSpacer />
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           OnClick="ClearAll">
                    Liste leeren
                </MudButton>
            </MudCardActions>
        }
    </MudCard>

    @* ── String-Generator-Karte ── *@
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" />
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.subtitle1"><b>String generieren</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Alle Adressen verbunden mit
                    <code style="background:var(--mud-palette-background-grey); padding:1px 5px; border-radius:3px"> OR </code>
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_generatedString != null)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3"
                          Style="word-break:break-all; font-family:monospace; font-size:0.85rem; background:var(--mud-palette-background-grey)">
                    @_generatedString
                </MudPaper>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-3" Style="font-style:italic">
                    Noch kein String – klicke auf „Generieren".
                </MudText>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="GenerateString"
                       Disabled="@(EmailService.Emails.Count == 0)">
                Generieren
            </MudButton>
            @if (_generatedString != null)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopyToClipboard"
                           Class="ml-2">
                    Kopieren
                </MudButton>
            }
        </MudCardActions>
    </MudCard>

</MudContainer>

@code {
    private string _inputEmail = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _generatedString;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private void AddEmail()
    {
        _errorMessage = null;
        _successMessage = null;

        var val = _inputEmail.Trim().ToLowerInvariant();

        if (string.IsNullOrEmpty(val))
        {
            _errorMessage = "Bitte gib eine E-Mail-Adresse ein.";
            return;
        }
        if (!IsValidEmail(val))
        {
            _errorMessage = "Ungültige E-Mail-Adresse.";
            return;
        }
        if (!EmailService.Add(val))
        {
            _errorMessage = $"\"{val}\" ist bereits in der Liste.";
            return;
        }

        _successMessage = $"\"{val}\" wurde hinzugefügt.";
        _inputEmail = string.Empty;
        _generatedString = null;
    }

    private void RemoveEmail(string email)
    {
        EmailService.Remove(email);
        _generatedString = null;
        _errorMessage = null;
        _successMessage = null;
    }

    private void ClearAll()
    {
        EmailService.Clear();
        _generatedString = null;
        _errorMessage = null;
        _successMessage = null;
    }

    private void GenerateString()
    {
        if (EmailService.Emails.Count == 0) return;
        _generatedString = EmailService.GenerateOrString();
    }

    private async Task CopyToClipboard()
    {
        if (_generatedString is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedString);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddEmail();
    }

    private static bool IsValidEmail(string email) =>
        Regex.IsMatch(email, @"^[^\s@]+@[^\s@]+\.[^\s@]{2,}$");
}